	package com.cts.service;

import java.net.Authenticator.RequestorType;
import java.util.List;
import java.util.stream.Collectors;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.cts.constants.Status;
import com.cts.dto.ShipmentRequest;
import com.cts.dto.ShipmentResponse;
import com.cts.dto.StatusUpdateRequest;
import com.cts.dto.UserIdDTO;
import com.cts.entity.Shipment;
import com.cts.exception.InvalidStatusException;
import com.cts.repository.ShipmentReposiotry;

@Service
public class ShipmentServiceImpl implements ShipmentService {

    @Autowired
    private ShipmentReposiotry repository;

    @Autowired
    private APIClient userClient;

    // ✅ OTP Generator
    private String generateOTP() {
        return String.valueOf((int)(Math.random() * 900000) + 100000);
    }

    // ✅ Create Shipment
    @Override
    public ShipmentResponse createShipment(ShipmentRequest request) {

        // ✅ Validate Customer
        UserIdDTO user = userClient.getUser(request.getCustomerId());
        if (user == null || user.getUserId() == null) {
            throw new RuntimeException("Invalid customer ID");
        }

        Shipment order = new Shipment();
        order.setCustomerId(request.getCustomerId());
        order.setOrigin(request.getOrigin());
        order.setDestination(request.getDestination());
        order.setWeight(request.getWeight());
        order.setStatus(Status.CREATED);

        repository.save(order);

        return mapToResponse(order);
    }

    // ✅ Get Shipment By ID
    @Override
    public ShipmentResponse getShipment(Long orderId) {
        Shipment order = repository.findById(orderId)
                .orElseThrow(() -> new RuntimeException("Shipment not found"));

        return mapToResponse(order);
    }

    // ✅ Get All Shipments
    @Override
    public List<ShipmentResponse> getAllShipments() {
        return repository.findAll()
                .stream()
                .map(this::mapToResponse)
                .collect(Collectors.toList());
    }

    // ✅ Approve Shipment + Generate OTP
    @Override
    public String approveShipment(Long orderId) {

        Shipment order = repository.findById(orderId)
                .orElseThrow(() -> new RuntimeException("Shipment not found"));

        order.setStatus(Status.APPROVED);

        String otp = generateOTP();
        order.setOtp(otp);

        repository.save(order);

        return "Shipment Approved. OTP: " + otp;
    }

    // ✅ Update Status
    public String updateStatus(Long orderId, StatusUpdateRequest request) {

        Shipment order = repository.findById(orderId)
                .orElseThrow(() -> new RuntimeException("Shipment not found"));

        try {
            // ✅ Convert request → enum
            Status status = Status.valueOf(request.getStatus().toUpperCase());

            // ✅ ✅ IMPORTANT FIX: convert enum → DB format
            String dbValue = status.name().replace("_", " ");

            // ✅ store correctly
            order.setStatus(Status.valueOf(dbValue.replace(" ", "_"))); 
            // workaround because entity expects enum

        } catch (IllegalArgumentException e) {
            throw new InvalidStatusException(
                    "Invalid status: " + request.getStatus() +
                    ". Allowed values: CREATED, APPROVED, IN_TRANSIT, DELIVERED, CLOSED, CANCELLED"
            );
        }

        repository.save(order);
        return "Status Updated";
    }

    // ✅ Cancel Shipment
    @Override
    public String cancelShipment(Long orderId) {

        Shipment order = repository.findById(orderId)
                .orElseThrow(() -> new RuntimeException("Shipment not found"));

        order.setStatus(Status.CANCELLED);
        repository.save(order);

        return "Shipment Cancelled";
    }

    // ✅ Track Shipment
    @Override
    public String trackShipment(Long orderId) {

        Shipment order = repository.findById(orderId)
                .orElseThrow(() -> new RuntimeException("Shipment not found"));

        return order.getStatus().name();
    }

    // ✅ Get Shipments By Customer (✅ ADDED VALIDATION HERE)
    @Override
    public List<ShipmentResponse> getShipmentsByCustomer(Long customerId) {

        // ✅ Validate customer exists
        UserIdDTO user = userClient.getUser(customerId);
        if (user == null || user.getUserId() == null) {
            throw new RuntimeException("Invalid customer ID");
        }

        return repository.findByCustomerId(customerId)
                .stream()
                .map(this::mapToResponse)
                .collect(Collectors.toList());
    }

    @Override
    public String getOtp(Long orderId) {

        Shipment order = repository.findById(orderId)
                .orElseThrow(() -> new RuntimeException("Shipment not found"));

        if (order.getOtp() == null) {
            throw new RuntimeException("OTP not generated yet. Approve shipment first.");
        }

        return order.getOtp();
    }

    // ✅ Mapping Method
    private ShipmentResponse mapToResponse(Shipment order) {

        ShipmentResponse response = new ShipmentResponse();

        response.setOrderId(order.getOrderId());
        response.setCustomerId(order.getCustomerId());
        response.setOrigin(order.getOrigin());
        response.setDestination(order.getDestination());
        response.setWeight(order.getWeight());
        response.setStatus(order.getStatus().name());

        return response;
    }
}