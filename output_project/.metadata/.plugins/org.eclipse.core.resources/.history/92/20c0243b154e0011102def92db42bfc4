package com.cts.repository;

import java.time.LocalDateTime;
import java.util.List;

import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;

import com.cts.entity.RouteSchedule;

public interface ScheduleRepository extends JpaRepository<RouteSchedule, Long> {

    @Query("""
        SELECT s FROM RouteSchedule s
        WHERE s.vehicleId = :vehicleId 
        AND (:start < s.arrivalAt AND :end > s.departureAt)
    """)
    List<RouteSchedule> findConflicts(Long vehicleId, LocalDateTime start, LocalDateTime end);
}