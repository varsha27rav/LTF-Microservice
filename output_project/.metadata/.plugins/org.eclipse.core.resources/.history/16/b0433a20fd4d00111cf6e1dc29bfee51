spring.application.name=API-Gateway
server.port=9739
spring.cloud.config.enabled=false

resilience4j.retry.instances.API-Gateway.max-attempts=5
resilience4j.retry.instances.API-Gateway.wait-duration=2s

spring.cloud.gateway.server.webflux.routes[0].id=Admin-Service
spring.cloud.gateway.server.webflux.routes[0].uri=http://localhost:8078
spring.cloud.gateway.server.webflux.routes[0].predicates[0]=Path=/api/admin/**

spring.cloud.gateway.server.webflux.routes[1].id=Audit-Service
spring.cloud.gateway.server.webflux.routes[1].uri=http://localhost:8085
spring.cloud.gateway.server.webflux.routes[1].predicates[0]=Path=/audit/**

spring.cloud.gateway.server.webflux.routes[2].id=fleet-service
spring.cloud.gateway.server.webflux.routes[2].uri=lb://fleet-service
spring.cloud.gateway.server.webflux.routes[2].predicates[0]=Path=/api/fleet/**,/api/dispatcher/**

spring.cloud.gateway.server.webflux.routes[3].id=driver-service
spring.cloud.gateway.server.webflux.routes[3].uri=lb://driver-service
spring.cloud.gateway.server.webflux.routes[3].predicates[0]=Path=/api/driver/**

spring.cloud.gateway.server.webflux.routes[4].id=Shipment-Service
spring.cloud.gateway.server.webflux.routes[4].uri=http://localhost:8081
spring.cloud.gateway.server.webflux.routes[4].predicates[0]=Path=/api/shipment/**

spring.cloud.gateway.server.webflux.routes[5].id=delivery-service
spring.cloud.gateway.server.webflux.routes[5].uri=http://localhost:8082
spring.cloud.gateway.server.webflux.routes[5].predicates[0]=Path=/api/delivery/**

