package com.cts.config;

import org.springframework.context.annotation.*;
import org.springframework.http.HttpStatus;
import org.springframework.security.config.annotation.web.reactive.*;
import org.springframework.security.config.web.server.*;
import org.springframework.security.web.server.SecurityWebFilterChain;

import com.cts.utility.JwtAuthenticationFilter;

import reactor.core.publisher.Mono;

@Configuration
@EnableWebFluxSecurity
public class SecurityConfig {

    private final JwtAuthenticationFilter jwtFilter;

    public SecurityConfig(JwtAuthenticationFilter jwtFilter) {
        this.jwtFilter = jwtFilter;
    }

    @Bean
    public SecurityWebFilterChain securityWebFilterChain(ServerHttpSecurity http) {

        return http
                .csrf(csrf -> csrf.disable())

                .exceptionHandling(ex -> ex
                        .authenticationEntryPoint((exchange, e) -> {
                            var response = exchange.getResponse();
                            response.setStatusCode(HttpStatus.UNAUTHORIZED);

                            var buffer = response.bufferFactory().wrap(
                                    "{\"message\":\"Unauthorized\"}".getBytes());

                            return response.writeWith(Mono.just(buffer));
                        })
                )

                .authorizeExchange(exchange -> exchange
                        .pathMatchers("/auth/**").permitAll()
                        .pathMatchers("/api/admin/users/**").hasRole("ADMIN")
                        .pathMatchers("/api/admin/**").permitAll()
                        .pathMatchers("/audit/**").permitAll()
                        .pathMatchers("/api/shipment/**").permitAll()
                        .pathMatchers("/api/delivery/**").permitAll()
                        .pathMatchers("/vehicles/**").permitAll()
                        .pathMatchers("/routes/**").permitAll()
                        .pathMatchers("/schedules/**").permitAll()
                        .pathMatchers("/assignments/**").permitAll()
                        .pathMatchers("/drivers/**").permitAll()
                        .pathMatchers("/trips/**").permitAll()
                        .anyExchange().authenticated()
                )

                .addFilterBefore(jwtFilter, SecurityWebFiltersOrder.AUTHENTICATION)
                .build();
    }
}